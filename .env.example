# Environment Variables for WasteWise
# Copy this file to .env and replace placeholders as needed

# Flask Secret Key for session security (change to a random string in production)
SECRET_KEY=dev-secret-key-waste-wise-2026

# Demonstration Admin Passcode for updating report status
ADMIN_PASSCODE=admin123

# Optional: Google Gemini API key or compatible OpenAI-style API key for AI assistant
# If left empty, WasteWise will automatically use its built-in intelligent rule-based categorization fallback!
GEMINI_API_KEY=
